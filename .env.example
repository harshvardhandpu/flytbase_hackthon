# ScoutOS - Environment Configuration
# Copy this file to .env and fill in your values.

# Application
APP_ENV=development

# Database (Local PostgreSQL)
DATABASE_URL=postgresql+psycopg://scoutos:scoutos@localhost:5432/scoutos

# Redis (optional)
# REDIS_URL=redis://localhost:6379/0

# AI Provider
# Options: freemodel, anthropic, openai, local (or unset for auto-detect)
# Auto-detection: ANTHROPIC_BASE_URL -> freemodel, OPENAI_API_KEY -> openai
# AI_PROVIDER=freemodel

# FreeModel (recommended for hackathon demo)
# ANTHROPIC_BASE_URL=https://cc.freemodel.dev
# ANTHROPIC_AUTH_TOKEN=replace-me

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Web Search
# Options: simulated (default, no key needed) or tavily
SEARCH_PROVIDER=simulated
# TAVILY_API_KEY=tvly-...
