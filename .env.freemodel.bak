# ScoutOS Configuration
# Copy this file to .env and fill in your values.

# Application
APP_NAME=ScoutOS
APP_ENV=development

# Database
DATABASE_URL=postgresql+psycopg://scoutos:scoutos@localhost:5432/scoutos

# Redis (optional, for task dispatch/caching)
REDIS_URL=

# AI Provider (anthropic, openai, freemodel, local)
AI_PROVIDER=freemodel

# Anthropic
ANTHROPIC_BASE_URL=https://cc.freemodel.dev
ANTHROPIC_AUTH_TOKEN=replace-me
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o

# Local Model
LOCAL_MODEL=

# Search Provider (tavily, simulated)
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=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
